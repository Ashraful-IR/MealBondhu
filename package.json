{
  "name": "mealbondhu",
  "version": "1.0.0",
  "private": true,
  "description": "MealBondhu bill management website with NestJS and Tailwind",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --files src/main.ts",
    "dev:api": "ts-node --files src/main.ts",
    "start:api": "node dist/main.js",
    "dev:web": "npm run dev --prefix web"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
